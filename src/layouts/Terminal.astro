---
interface Props {
    path?: string
}

const { path = "food://terminal" } = Astro.props
---

<section
    aria-label="Food recommendation terminal"
    class="bg-card w-full max-w-5xl border p-2 sm:p-3"
>
    <div class="bg-background/90 z-20 border p-3 sm:p-4">
        <div
            class="text-muted-foreground flex flex-wrap items-center justify-between gap-2 border-b pb-1 text-xs tracking-widest uppercase"
        >
            <p>{path}</p>
            <p>state: ready</p>
        </div>
        <div class="p-6">
            <slot />
        </div>
    </div>
</section>
