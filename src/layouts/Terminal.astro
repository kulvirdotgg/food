---
interface Props {
    path?: string
    scrollable?: boolean
    class?: string
}

const {
    path = "food://terminal",
    scrollable = false,
    class: className,
} = Astro.props
---

<section
    aria-label="Food recommendation terminal"
    class:list={["bg-card w-full max-w-5xl border p-2 sm:p-3", className]}
>
    <div class="bg-background/90 z-20 border p-3 sm:p-4">
        <div
            class="text-muted-foreground flex flex-wrap items-center justify-between gap-2 border-b pb-1 text-xs tracking-widest uppercase"
        >
            <p>{path}</p>
            <nav class="flex items-center gap-3">
                <slot name="nav" />
            </nav>
        </div>
        <div
            class:list={[
                "p-6",
                scrollable &&
                    "max-h-[58vh] overflow-y-auto [scrollbar-color:var(--color-accent)_transparent] [scrollbar-width:thin]",
            ]}
        >
            <slot />
        </div>
    </div>
</section>
