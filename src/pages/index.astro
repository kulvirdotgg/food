---
import { Show, SignIn, UserButton } from "@clerk/astro/components"

import Layout from "@/layouts/Layout.astro"
import Home from "@/components/Home.astro"
import "@/globals.css"
---

<Layout>
    <Show when="signed-in">
        <div class="absolute top-8 right-4 sm:right-6 lg:right-8">
            <UserButton />
        </div>
    </Show>

    <Show when="signed-out">
        <SignIn />
    </Show>
    <Show when="signed-in">
        <Home />
    </Show>
</Layout>
