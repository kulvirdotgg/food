---
import Layout from "@/layouts/Layout.astro"
import Terminal from "@/layouts/Terminal.astro"
import "@/globals.css"
---

<Layout>
    <Terminal>
        <div class="grid justify-items-center gap-6 text-center">
            <p
                class="text-accent text-xs font-semibold tracking-widest uppercase"
            >
                [ lost? ]
            </p>
            <p class="text-muted-foreground max-w-2xl text-sm uppercase">
                This page doesn't exist. Maybe it never did. Maybe you typed the
                wrong URL. Either way, not our fault this time.
            </p>
            <a
                href="/"
                class="text-accent text-xs font-semibold tracking-widest uppercase underline-offset-4 hover:underline"
            >
                [ go home ]
            </a>
        </div>
    </Terminal>
</Layout>
