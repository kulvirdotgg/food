---
import Card from "@/components/card.astro"
import {
    exploratoryDishSelector,
    recommendationDishSelector,
} from "@/lib/agent"
import { RecommendationService } from "@/lib/recommendation"

const { userId } = Astro.locals.auth()
if (!userId) {
    return Astro.redirect("/")
}

const service = new RecommendationService({
    recommendationSelector: new recommendationDishSelector(),
    exploratorySelector: new exploratoryDishSelector(),
})

const { recommended, others } = await service.recommend(userId)
---

<div class="grid justify-items-center gap-6 text-center">
    <p class="text-accent text-xs font-semibold tracking-widest uppercase">
        [ today's picks ]
    </p>
    <div
        class="grid w-full max-w-6xl grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 lg:gap-4"
    >
        <Card
            label={recommended.label}
            name={recommended.dish.name}
            index={1}
            meta={recommended.dish.cuisines.join(", ")}
            ingredients={recommended.dish.ingredients}
            class="border-primary/70 bg-primary/10 sm:col-span-2 lg:col-span-3"
        />
        {
            others.map((rec, i) => (
                <Card
                    label={rec.label}
                    name={rec.dish.name}
                    index={i + 2}
                    meta={rec.dish.cuisines.join(", ")}
                    ingredients={rec.dish.ingredients}
                />
            ))
        }
    </div>
</div>
