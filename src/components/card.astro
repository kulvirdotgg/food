---
import Badge from "@/components/badge.astro"

const { label, name, index, meta, ingredients, class: className } = Astro.props
---

<article
    aria-label="Food Card"
    class:list={[
        "bg-card text-card-foreground grid content-start gap-2 border px-2.5 py-2.5 text-left sm:px-3",
        className,
    ]}
>
    <div class="flex items-start justify-between gap-2 border-b pb-2">
        <div class="grid gap-1">
            <p
                class="text-accent m-0 text-[0.65rem] font-semibold tracking-widest uppercase"
            >
                {label}
            </p>
            <p
                class="text-card-foreground m-0 text-sm font-semibold tracking-widest uppercase sm:text-base"
            >
                {name}
            </p>
            <p
                class="text-muted-foreground m-0 text-xs tracking-widest uppercase"
            >
                {meta}
            </p>
        </div>
        <p class="text-accent m-0 shrink-0 text-xs tracking-widest uppercase">
            #{index}
        </p>
    </div>
    <div aria-label="Top ingredients" class="flex flex-wrap gap-1.5">
        {ingredients.map((ingredient) => <Badge label={ingredient} />)}
    </div>
</article>
