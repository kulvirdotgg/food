---
import Terminal from "../layouts/Terminal.astro"
---

<Terminal>
    <div class="grid justify-items-center gap-3 text-center">
        <h1
            class="w-full max-w-2xl text-3xl leading-tight font-semibold tracking-widest text-balance uppercase sm:text-5xl"
        >
            queue up your next meal.
        </h1>
        <a
            href="/recommend"
            aria-label="Generate food recommendations"
            class="border-primary bg-primary text-primary-foreground focus:ring-ring/20 border px-4 py-2.5 text-sm font-semibold tracking-widest uppercase transition-all duration-200 hover:-translate-x-0.5 hover:-translate-y-0.5 focus:ring-4 focus:outline-none"
        >
            [ Generate Recommendations ]
        </a>
    </div>
</Terminal>
