---
import Terminal from "../layouts/Terminal.astro"
---

<Terminal>
    <div class="grid gap-3 justify-items-center text-center">
        <h1
            class="w-full max-w-2xl text-balance text-3xl leading-tight font-semibold uppercase tracking-widest sm:text-5xl"
        >
            queue up your next meal.
        </h1>
        <button
            type="button"
            aria-label="Generate food recommendations"
            class="border border-primary px-4 py-2.5 bg-primary text-sm font-semibold uppercase text-primary-foreground tracking-widest transition-all duration-200 hover:-translate-x-0.5 hover:-translate-y-0.5 focus:outline-none focus:ring-4 focus:ring-ring/20"
        >
            [ Generate Recommendations ]
        </button>
    </div>
</Terminal>
