    aria-label="Loading recommendation history"
    class="grid gap-4"
>
    <div class="bg-muted h-3 w-44 animate-pulse"></div>
    {
        ([6, 5, 4] as const).map((count, i) => (
            <div class="bg-card/60 border">
                <div class="flex items-center justify-between border-b px-3 py-2">
                    <div class="bg-muted h-2.5 w-28 animate-pulse" />
                    <div class="bg-muted h-2.5 w-8 animate-pulse" />
                </div>
                <div class="grid grid-cols-2 gap-1.5 p-2.5 sm:grid-cols-3">
                    {Array.from({ length: count }).map(() => (
                        <div class="border-border/60 grid gap-1.5 border px-2 py-1.5">
                            <div class="bg-muted h-2.5 w-3/4 animate-pulse" />
                            <div class="bg-muted h-2 w-1/2 animate-pulse" />
                        </div>
                    ))}
                </div>
            </div>
        ))
