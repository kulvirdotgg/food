---
interface Props {
    label?: string
    message?: string
}

const {
    label = "[ my bad ]",
    message = "Something broke. The devs are aware and deeply underpaid. Consider sponsoring the project so this never happens again.",
} = Astro.props
---

<div class="grid justify-items-center gap-6 text-center">
    <p class="text-accent text-xs font-semibold tracking-widest uppercase">
        {label}
    </p>
    <p class="text-muted-foreground max-w-2xl text-sm uppercase">
        {message}
    </p>
    <a
        href="/"
        class="text-accent text-xs font-semibold tracking-widest uppercase underline-offset-4 hover:underline"
    >
        [ go home ]
    </a>
</div>
